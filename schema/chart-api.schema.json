{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingDesk Chart API configuration",
  "type": "object",
  "required": ["id", "name", "enabled", "api", "response"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$", "not": {"enum": ["mock", "unconfigured"]}},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string"},
    "enabled": {"const": false},
    "supported_markets": {"type": "array", "uniqueItems": true, "items": {"enum": ["CN", "US", "HK", "CRYPTO"]}},
    "supported_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object"},
    "period_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
    "symbol": {"type": "object"},
    "limits": {"type": "object", "additionalProperties": false, "properties": {
      "max_data_points": {"type": "integer", "minimum": 0},
      "supported_periods": {"type": "array", "items": {"type": "string"}},
      "unsupported_message": {"type": "string"}
    }},
    "api": {
      "type": "object", "required": ["base_url"], "additionalProperties": false,
      "anyOf": [{"required": ["kline"]}, {"required": ["trend"]}, {"required": ["realtime"]}, {"required": ["batch_realtime"]}],
      "properties": {
        "base_url": {"type": "string", "pattern": "^https?://[^/@]+"},
        "timeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m)$"},
        "max_retry": {"type": "integer", "minimum": 0, "maximum": 5},
        "retry_backoff": {"type": "string"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "kline": {"$ref": "#/$defs/endpoint"},
        "trend": {"$ref": "#/$defs/endpoint"},
        "realtime": {"$ref": "#/$defs/endpoint"},
        "batch_realtime": {"$ref": "#/$defs/endpoint"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "encoding": {"type": "string"}, "format": {"enum": ["json", "text", "csv"]},
        "kline": {"$ref": "#/$defs/parser"}, "trend": {"$ref": "#/$defs/parser"},
        "realtime": {"$ref": "#/$defs/parser"}, "batch_realtime": {"$ref": "#/$defs/parser"}
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object", "required": ["endpoint"], "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string", "minLength": 1},
        "method": {"enum": ["GET", "POST"]},
        "date_format": {"type": "string"},
        "params": {"type": "object", "additionalProperties": {"type": "string"}},
        "batch_size": {"type": "integer", "minimum": 1}
      }
    },
    "parser": {
      "type": "object",
      "properties": {
        "data_path": {"type": "string"},
        "row_format": {"enum": ["object", "array", "csv", "csv_string", "text"]},
        "field_mapping": {"type": "object"}
      }
    }
  }
}
